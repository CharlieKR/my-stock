# Use dedicated PostgreSQL reader connections (direct or session pooler), not service-role keys.
MY_STOCK_LST_DATABASE_URL=postgresql://my_stock_reader:REPLACE@HOST:5432/postgres
MY_STOCK_KST_DATABASE_URL=postgresql://my_stock_reader:REPLACE@HOST:5432/postgres
MY_STOCK_HYXL_PORTFOLIOS=kiwoom_main,ls_main
MY_STOCK_READER_TOKEN=REPLACE_WITH_RANDOM_DEVICE_KEY
HOST=127.0.0.1
PORT=8787
# Only the separate FX worker needs this credential; do not give it to the read server.
# MY_STOCK_FX_DATABASE_URL=postgresql://my_stock_fx_writer:REPLACE@HOST:5432/postgres
